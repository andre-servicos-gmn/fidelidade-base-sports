# Copie este arquivo para .env e preencha com valores reais.
# O .env está no .gitignore — NUNCA commite credenciais.

# --- TouchPay ---------------------------------------------------------------
# URL base da API TouchPay de produção (apenas LEITURA — não há sandbox).
TOUCHPAY_BASE_URL=https://api.touchpay.example.com

# Bearer token da TouchPay (só o JWT, sem o prefixo "Bearer "). Segredo: nunca
# commitar. O cliente nunca o imprime em log/erro.
TOUCHPAY_TOKEN=

# Quando true, usa o MockTouchPayClient (em memória, sem rede). Default seguro.
# Troque para false para LER da produção real via HttpTouchPayClient.
USE_MOCK_TOUCHPAY=true

# --- Banco de dados (Supabase / PostgreSQL) ---------------------------------
# Direct connection (porta 5432) do Supabase, no formato asyncpg.
# Pegue em: Supabase > Project Settings > Database > Connection string > URI,
# e troque o prefixo "postgresql://" por "postgresql+asyncpg://".
DATABASE_URL=postgresql+asyncpg://postgres:[SUA_SENHA]@db.[SEU_REF].supabase.co:5432/postgres

# --- Segurança --------------------------------------------------------------
# Segredo (pepper) do HMAC-SHA256 do CPF. Gere um valor aleatório forte, ex:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Trate como segredo: quem tiver a pepper pode recomputar hashes de CPF.
CPF_PEPPER=troque-por-um-segredo-aleatorio-forte

# --- WhatsApp / Evolution API -----------------------------------------------
# URL base da Evolution API e credenciais da instância (para ENVIAR mensagens).
EVOLUTION_BASE_URL=https://evolution.seu-dominio.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=fidelidade
# Quando true, usa o MockMessageSender (não envia de verdade). Troque para false
# quando a Evolution real estiver configurada.
USE_MOCK_WHATSAPP=true
# Segredo validado no header X-Webhook-Token a cada POST do webhook. Gere com:
#   python -c "import secrets; print(secrets.token_hex(24))"
WEBHOOK_TOKEN=troque-por-um-segredo-aleatorio-forte

# --- Estado conversacional (SessionStore / Redis) ---------------------------
# Connection string do Redis. Upstash/Redis Cloud usam TLS -> `rediss://`.
# Vazia = sem Redis (usa o store em memória). Ex:
#   rediss://default:[SENHA]@[HOST].upstash.io:6379
REDIS_URL=
# Quando true, o estado da conversa vai para o Redis (compartilhado entre
# processos/workers). Necessário para multi-worker OU worker de polling
# separado. Default false = store em memória (só serve para 1 worker).
USE_REDIS_SESSION_STORE=false
# TTL de inatividade de uma conversa (segundos). Vale para os dois stores.
# Cobre so a conversa normal; a pergunta de indicacao pos-compra fica no banco.
SESSION_TTL_SECONDS=3600
# Dias em que a resposta a pergunta de indicacao ainda e' aceita.
AFFILIATE_ANSWER_WINDOW_DAYS=7

# --- Agendador de polling (worker de ingestão) ------------------------------
# Intervalo entre ciclos de polling da TouchPay (segundos). 300 = a cada 5 min.
POLL_INTERVAL_SECONDS=300
# Janela lida a cada ciclo (minutos). Deve ser MAIOR que o intervalo (sobreposta)
# para nenhuma compra escapar entre ciclos. A idempotência evita crédito duplo.
POLL_WINDOW_MINUTES=30
# PDV (pointOfSaleId) da Base Sports para filtrar a leitura. Vazio = todos.
POLL_POINT_OF_SALE_ID=
# Quando true, a API sobe o worker de polling NO MESMO PROCESSO (simples, ideal
# para 1 worker/testes). Em produção multi-processo, deixe false e rode o worker
# à parte: `python -m app.worker` (com SessionStore compartilhado/Redis).
RUN_WORKER_IN_APP=false

# --- Log --------------------------------------------------------------------
# INFO mostra cada ciclo do worker (compras lidas/creditadas); WARNING esconde.
LOG_LEVEL=INFO

# --- API administrativa (JWT) -----------------------------------------------
# Segredo de assinatura do JWT do painel admin. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-um-segredo-aleatorio-forte
JWT_EXPIRATION_HOURS=8
# Senha do admin inicial (lida pelo scripts/seed_admin.py). Se vazia, o script
# gera e imprime uma senha aleatória no primeiro run.
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_USERNAME=admin

# --- WhatsApp Cloud API (Meta) ---
# Convive com a Evolution: webhooks em caminhos separados, envio escolhido por
# USE_META_WHATSAPP. Migrar e voltar atras e' so' trocar essa flag.
#
# Token que VOCE inventa; o mesmo valor vai no campo "Verify token" da Meta.
META_VERIFY_TOKEN=
# App Secret (painel da Meta > Configuracoes > Basico). Assina cada evento.
META_APP_SECRET=
# Token de System User (o da tela de setup expira em 24h) e id do numero.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v21.0
# Segredo no CAMINHO do webhook, usado quando o App Secret nao esta disponivel:
# a URL cadastrada na Meta vira /webhook/meta/<segredo>. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vazio = so o HMAC protege. Preencher os dois = os dois valem (recomendado).
# ATENCAO: segredo em URL aparece em log de acesso e de proxy. Prefira o
# META_APP_SECRET assim que puder; este e' ponte, nao destino.
META_WEBHOOK_PATH_SECRET=
# true -> envio pela Cloud API; false -> Evolution.
USE_META_WHATSAPP=false
# Nome do template aprovado da pergunta de afiliado pos-compra (a unica
# mensagem que o sistema inicia). Preencha DEPOIS da aprovacao na Meta; vazio
# faz cair para texto livre, recusado com erro 131047 fora da janela de 24h.
META_AFFILIATE_TEMPLATE=
# Idioma do template, exatamente como cadastrado na Meta.
META_TEMPLATE_LANGUAGE=pt_BR

# --- Repasse ao sistema de boas-vindas (mesmo numero, outro sistema) ---
# A loja usa o MESMO numero em dois sistemas, e a Meta entrega os eventos a UM
# callback so' (este). O boas-vindas (saudacao por voz) pede consentimento por
# template com botoes; so' o evento com toque nesses botoes e' repassado a ele
# (minimizacao: as conversas com o robo de fidelidade nao saem daqui), e esse
# toque nunca entra na conversa daqui, com o repasse ligado ou nao.
#
# URL COMPLETA do webhook do boas-vindas. Contem o segredo de caminho dele:
# nunca commitar nem colar em grupo/print. Vazio = nao repassa. Formato:
#   https://exemplo.invalid/api/v1/whatsapp/webhook/<segredo-do-boas-vindas>
BOASVINDAS_FORWARD_URL=
# Timeout do repasse (segundos). Roda depois do 200 a' Meta.
BOASVINDAS_FORWARD_TIMEOUT_SECONDS=3.0
# Payloads dos botoes do template do boas-vindas, separados por virgula (sem
# diferenciar maiusculas). Nao reutilize esses payloads em templates daqui.
BOASVINDAS_BUTTON_PAYLOADS=ACEITO,NAO_ACEITO
